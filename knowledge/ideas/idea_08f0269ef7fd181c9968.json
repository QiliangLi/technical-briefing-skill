  ],
  "validation_plan": {
    "mode": "simulation",
    "minimal_model": "带有限显存、前缀流行度和请求路由的多节点缓存模拟器。",
    "inputs": [
      "Zipf 热度参数",
      "复制因子",
      "缓存容量",
      "节点数",
      "前缀更新率"
    ],
    "baselines": [
      "无复制的一致性哈希",
      "本地 LRU",
      "固定复制因子"
    ],
    "metrics": [
      "P95 TTFT",
      "跨节点传输字节",
      "重复 Prefill 次数",
      "显存占用",
      "复制写放大"
    ],
    "support_criteria": [
      "在显存预算内持续降低重复 Prefill 和尾 TTFT，复制写放大保持可控。"
    ],
    "reject_criteria": [
      "热度漂移使复制抖动抵消检索收益，或目录/同步成本高于重算。"
    ],
    "limitations": [
      "模拟不能覆盖真实模型前缀可共享性、租户安全和网络故障恢复。"
    ],
    "execution_status": "suggestion_only"
  },
