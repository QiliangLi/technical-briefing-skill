  "roadmaps": [
    {
      "topic_id": "agent_acceleration",
      "topic_name": "Agent语义加速",
      "path": "knowledge/roadmaps/agent_acceleration.json",
      "version": 2,
      "change_type": "no_material_change",
      "updated_by_issue": "2026-09-03",
      "summary": "harness 工程在本期从经验总结推进到机制化:REVISE 把修订恢复做成按数据/控制依赖只重算受影响区域的细粒度机制,ContextPipe 把上下文组装做成可审计、可重放的运行时层,SkillZip 量化了渐进加载 skill 束的压缩杠杆,IssueLoc 证明仓库探索可交给低成本模型(保留78~94%定位、省84~95% token)。读取、工具链与harness四条线维持emerging判断,当前最值得动手的是把上下文与恢复策略当作可测量的工程对象。"
    },
    {
      "topic_id": "ai_chip_accelerator",
      "topic_name": "AI芯片与加速器",
      "path": "knowledge/roadmaps/ai_chip_accelerator.json",
      "version": 2,
      "change_type": "no_material_change",
      "updated_by_issue": "2026-09-03",
      "summary": "本期芯片方向的重心从架构提案转向可验证的能效与数据通路证据:HBQ在28nm原型上把KV cache纳入统一低精度通路(系统能效1.6~3.3倍提升),CE-MoE用层重构把MoE训练的all-to-all通信与GPU-hours砍三成,请求/token双视角能耗刻画给出批处理与上下文长度的核算边界。加速器判断维持emerging,量产与实测边界仍以各条目自述为准。"
    },
    {
      "topic_id": "ai_infra_horizontal",
      "topic_name": "AI Infra横向动态",
      "path": "knowledge/roadmaps/ai_infra_horizontal.json",
      "version": 1,
      "change_type": "material_change",
      "updated_by_issue": "2026-08-11",
      "summary": "现有公开归档为“AI Infra横向动态”积累了 6 条专题证据，但时间跨度和跨期关联仍不足以可靠划分技术阶段，首版先保留可追溯的证据时间线。"
    },
    {
      "topic_id": "cross_region",
      "topic_name": "跨域传输",
      "path": "knowledge/roadmaps/cross_region.json",
      "version": 1,
      "change_type": "no_material_change",
      "updated_by_issue": "2026-09-03",
      "summary": "跨域KV缓存的证据重心从压缩本身转向质量验收与放置机制:离线KV缓存量化审计给出INT4下忠实性回归不可见的部署红线,DASC把前缀复用检查点压缩2.63倍并降TTFT四成,DualDecoder用预测预取替代驻留式检索,CoSMO示范按决策效价而非新鲜度刷新远端状态。放置与传输维持emerging,压缩后质量验收成为新增的明确门槛。"
    },
    {
      "topic_id": "dpu_inline",
      "topic_name": "DPU随路卸载",
      "path": "knowledge/roadmaps/dpu_inline.json",
      "version": 1,
      "change_type": "material_change",
      "updated_by_issue": "2026-08-10",
      "summary": "现有公开归档为“DPU随路卸载”积累了 3 条专题证据，但时间跨度和跨期关联仍不足以可靠划分技术阶段，首版先保留可追溯的证据时间线。"
    },
    {
      "topic_id": "memory_dsa",
      "topic_name": "内存语义、DSA卸载",
      "path": "knowledge/roadmaps/memory_dsa.json",
      "version": 1,
      "change_type": "no_material_change",
      "updated_by_issue": "2026-08-29",
      "summary": "内存语义与 DSA 卸载的公开证据集中在 CXL 内存语义一条线；本期新增 MemChannel 在真实 CXL 交换内存池上刻画三类性能干扰并提出 CSFQ 式公平传输层、实现多租户隔离，把该方向从接口/协议记录推进到实测干扰刻画。当前判断：CXL 内存池化的多租户公平性与干扰隔离是当前证据最集中的问题，方向整体仍为 emerging，等待更多真实交换机部署数据后再考虑阶段划分。"
    },
    {
      "topic_id": "optical_network",
      "topic_name": "光交换网络",
      "path": "knowledge/roadmaps/optical_network.json",
      "version": 1,
      "change_type": "material_change",
      "updated_by_issue": "2026-09-03",
      "summary": "光交换方向的公开机器证据刚出现第一条可直接引用的器件级信号:zero-change代工兼容的硅光MEMS光开关把OCS器件获取门槛与标准工艺绑定;在出现端口规模、插损与混合组网实测之前,该方向保持器件级信号跟踪,出现上述实测即可升级为可评估的器件路线。"
    },
    {
      "topic_id": "storage_media",
      "topic_name": "存储介质与器件",
      "path": "knowledge/roadmaps/storage_media.json",
      "version": 1,
      "change_type": "no_material_change",
      "updated_by_issue": "2026-08-29",
      "summary": "存储介质与器件的公开证据集中在 Flash/NAND/HBF 与介质-控制器协同两条线；本期新增 FLINT 把 HBF 作为 HBM 旁的只读权重容量层（burst 缓冲控制器、phantom-plane 刷新与只读 FTL 把 NAND 管理移出推理关键路径）与 SxSSD 的机制-策略解耦安全 SSD，前者直接推进了 HBF 进入 AI 推理存储层次的可行性。当前判断：HBF 作为推理权重容量层是该方向证据最强的落地路径，但仍缺系统级实测对比；全部按 emerging 记录，不划分阶段。"
    },
    {
      "topic_id": "tpn",
      "topic_name": "状态感知网络、TPN",
      "path": "knowledge/roadmaps/tpn.json",
      "version": 2,
      "change_type": "no_material_change",
      "updated_by_issue": "2026-09-03",
      "summary": "P/D与KV传输的两条默认假设在本期同时被机制级工作收窄:AInfer-PD以集合通信顺序协调加DeepEP状态隔离实现免KV跨池传输的原位复用,CacheBridge把跨模型KV迁移做成闭式映射并三降成本,DAMP把线性注意力递归状态量化到9.9bit实用点,Pro-Router示范token级置信度做边缘云分级路由。KVCache感知调度维持emerging主线,网络侧机制的价值已经可以用具体吞吐与成本数字陈述。"
    }
  ],
