{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Group assistant assessment of one discussion",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "_task", "rules", "doc_id", "relevance"],
  "properties": {
    "schema_version": {"const": 1},
    "_task": {
      "type": "object",
      "required": ["task_id", "kind"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "kind": {"const": "assess"}
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "matches", "evidence_quote", "reason"],
        "properties": {
          "rule_id": {"type": "string", "minLength": 1, "maxLength": 64},
          "matches": {"type": "boolean"},
          "evidence_quote": {"type": "string", "maxLength": 200},
          "reason": {"type": "string", "minLength": 1, "maxLength": 300}
        }
      }
    },
    "doc_id": {"type": ["string", "null"], "maxLength": 200},
    "relevance": {"enum": ["high", "medium", "low", "none"]}
  }
}
