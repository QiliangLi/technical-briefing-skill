{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Group assistant refinement of one question",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "_task",
    "queries",
    "selected",
    "none_relevant"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "_task": {
      "type": "object",
      "required": [
        "task_id",
        "kind"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "refine"
        }
      }
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "selected": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "doc_id",
          "quote"
        ],
        "properties": {
          "doc_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    "none_relevant": {
      "type": "boolean"
    },
    "framing": {
      "type": "string",
      "maxLength": 200
    }
  }
}
