{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["patches"],
  "properties": {
    "patches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["brief_item_id", "field", "before", "after", "reason"],
        "properties": {
          "brief_item_id": {"type": "string", "minLength": 1},
          "field": {
            "type": "string",
            "enum": [
              "title",
              "core_conclusion",
              "mechanism",
              "result",
              "boundary",
              "project_relevance"
            ]
          },
          "before": {"type": "string", "minLength": 1},
          "after": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 4, "maxLength": 120}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
