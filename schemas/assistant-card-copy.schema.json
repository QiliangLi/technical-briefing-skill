{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Group assistant plain-language copy for one idea card",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "_task", "headline", "summary", "why_it_matters"],
  "properties": {
    "schema_version": {"const": 1},
    "_task": {
      "type": "object",
      "required": ["task_id", "kind"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "kind": {"const": "card_copy"}
      }
    },
    "headline": {"type": "string", "minLength": 1, "maxLength": 40},
    "summary": {"type": "string", "minLength": 1, "maxLength": 120},
    "why_it_matters": {"type": "string", "minLength": 1, "maxLength": 100}
  }
}
