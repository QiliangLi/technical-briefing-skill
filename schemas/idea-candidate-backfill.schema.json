{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Historical Idea Candidate review ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_scope", "through_issue", "issues", "generated_at"],
  "properties": {
    "schema_version": {"const": 1},
    "evidence_scope": {"const": "published_archive_only"},
    "through_issue": {"type": "string", "format": "date"},
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issue_date", "items"],
        "properties": {
          "issue_date": {"type": "string", "format": "date"},
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["item_id", "result", "candidate_ids", "reason_code", "reason"],
              "properties": {
                "item_id": {"type": "string", "minLength": 1},
                "result": {"enum": ["candidate", "no_op"]},
                "candidate_ids": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {"type": "string", "pattern": "^candidate_[a-f0-9]{20}$"}
                },
                "reason_code": {"enum": ["candidate_evidence", "existing_idea_evidence", "no_new_semantics", "ineligible_radar", "unstable_frontier_topic"]},
                "reason": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "generated_at": {"type": "string"}
  }
}
