{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded knowledge materialization result",
  "type": "object",
  "additionalProperties": false,
  "required": ["roadmap", "ideas", "frontier_clusters"],
  "properties": {
    "roadmap": {
      "type": "object",
      "required": ["roadmap_id", "topic_id", "topic_name", "evidence_scope", "updated_by_issue", "summary", "view_mode", "branches"],
      "properties": {
        "roadmap_id": {"type": "string", "pattern": "^roadmap_[a-z0-9_]+$"},
        "topic_id": {"type": "string", "minLength": 1},
        "topic_name": {"type": "string", "minLength": 1},
        "evidence_scope": {"const": "published_archive_only"},
        "updated_by_issue": {"type": "string", "format": "date"},
        "summary": {"type": "string", "minLength": 1},
        "view_mode": {"enum": ["roadmap", "evidence_timeline"]},
        "branches": {"type": "array"}
      }
    },
    "ideas": {"type": "array", "items": {"type": "object"}},
    "frontier_clusters": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["cluster_id", "name", "status", "first_seen_issue", "last_seen_issue", "evidence_item_ids", "source_urls", "idea_ids", "promotion_reason"],
        "properties": {
          "cluster_id": {"type": "string", "pattern": "^frontier_[a-z0-9_]+$"},
          "name": {"type": "string", "minLength": 1},
          "status": {"enum": ["temporary", "promoted"]},
          "first_seen_issue": {"type": "string", "format": "date"},
          "last_seen_issue": {"type": "string", "format": "date"},
          "evidence_item_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "source_urls": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uri"}},
          "idea_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^idea_[a-f0-9]{20}$"}},
          "promotion_reason": {"type": ["string", "null"]}
        }
      }
    }
  }
}
