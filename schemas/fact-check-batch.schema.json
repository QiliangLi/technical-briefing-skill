{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["results"],
  "properties": {
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["brief_item_id", "pass", "issues", "corrected_item"],
        "properties": {
          "brief_item_id": {"type": "string", "minLength": 1},
          "pass": {"type": "boolean"},
          "issues": {"type": "array", "items": {"type": "string"}},
          "corrected_item": {"type": ["object", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}