{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["title", "event_hint", "problem", "mechanism", "evidence", "evaluation_context", "limitations", "project_relevance", "primary_source_resolved", "quality_score"],
  "properties": {
    "title": {"type": "string"},
    "event_hint": {"type": "string"},
    "problem": {"type": "string"},
    "mechanism": {"type": "string"},
    "evidence": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["claim", "source_locator"],
        "properties": {
          "claim": {"type": "string"},
          "value": {"type": ["string", "number", "null"]},
          "baseline": {"type": ["string", "null"]},
          "condition": {"type": ["string", "null"]},
          "source_locator": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "evaluation_context": {"type": "string"},
    "limitations": {"type": "string"},
    "project_relevance": {"type": "string"},
    "primary_source_resolved": {"type": "boolean"},
    "quality_score": {"type": "number", "minimum": 0, "maximum": 100},
    "source_notes": {"type": "array", "items": {"type": "string"}},
    "evidence_gaps": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["question", "terms"],
        "properties": {
          "question": {"type": "string", "minLength": 4, "maxLength": 240},
          "terms": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {"type": "string", "minLength": 2, "maxLength": 80}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
