{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["concept_name", "status", "prompt", "labels", "generated_asset_path", "qa_notes"],
  "properties": {
    "concept_name": {"type": "string"},
    "status": {"type": "string", "enum": ["generated", "waiting_for_image_generation", "fallback_to_text", "failed"]},
    "prompt": {"type": "string"},
    "labels": {"type": "array", "maxItems": 5, "items": {"type": "string"}},
    "generated_asset_path": {"type": ["string", "null"]},
    "qa_notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
