{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Group assistant's picks from a new issue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "_task", "picks"],
  "properties": {
    "schema_version": {"const": 1},
    "_task": {
      "type": "object",
      "required": ["task_id", "kind"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "kind": {"const": "alert"}
      }
    },
    "picks": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["doc_id", "quote", "why"],
        "properties": {
          "doc_id": {"type": "string", "minLength": 1, "maxLength": 200},
          "quote": {"type": "string", "minLength": 2, "maxLength": 200},
          "why": {"type": "string", "minLength": 1, "maxLength": 120}
        }
      }
    }
  }
}
