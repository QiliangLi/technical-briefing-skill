{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "visual_mode",
    "visual_purpose",
    "structure",
    "labels",
    "aspect_ratio",
    "accent",
    "factual_constraints",
    "persona_mode"
  ],
  "properties": {
    "visual_mode": {
      "type": "string",
      "enum": [
        "source_figure",
        "official_image",
        "screenshot",
        "chart_redraw",
        "material_mechanism",
        "persona_metaphor",
        "text_only"
      ]
    },
    "visual_purpose": {
      "type": "string"
    },
    "structure": {
      "type": "string"
    },
    "labels": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string",
        "maxLength": 12
      }
    },
    "aspect_ratio": {
      "type": "string",
      "enum": [
        "1.9:1",
        "16:9",
        "1:1",
        "none"
      ]
    },
    "accent": {
      "type": "string"
    },
    "factual_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "persona_mode": {
      "type": "string",
      "enum": [
        "none",
        "signature",
        "observer",
        "operator",
        "protagonist"
      ]
    },
    "persona_action": {
      "type": [
        "string",
        "null"
      ]
    },
    "asset_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_asset_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "reason": {
      "type": "string"
    },
    "chart_data": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "title",
            "labels",
            "values",
            "unit"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "labels": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "number"
              }
            },
            "unit": {
              "type": "string"
            },
            "note": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}