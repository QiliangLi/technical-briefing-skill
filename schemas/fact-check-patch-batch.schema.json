{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["results"],
  "properties": {
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["brief_item_id", "pass", "issues", "corrections"],
        "properties": {
          "brief_item_id": {"type": "string", "minLength": 1},
          "pass": {"type": "boolean"},
          "issues": {"type": "array", "items": {"type": "string"}},
          "corrections": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["field", "before", "after", "reason"],
              "properties": {
                "field": {
                  "enum": ["title", "core_conclusion", "mechanism", "result", "boundary", "project_relevance"]
                },
                "before": {"type": "string"},
                "after": {"type": "string", "minLength": 1},
                "reason": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
