{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["results"],
  "properties": {
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["brief_item_id", "title", "lead", "body", "used_fields"],
        "properties": {
          "brief_item_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 4, "maxLength": 56},
          "lead": {"type": "string", "minLength": 20, "maxLength": 180},
          "body": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {"type": "string", "minLength": 20, "maxLength": 240}
          },
          "takeaway": {"type": ["string", "null"], "maxLength": 180},
          "used_fields": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["title", "core_conclusion", "mechanism", "result", "boundary", "project_relevance"]
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
