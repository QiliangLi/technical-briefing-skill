{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["results"],
  "properties": {
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["brief_item_id", "title", "blocks", "used_fields"],
        "properties": {
          "brief_item_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 4, "maxLength": 72},
          "blocks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "required": ["heading_key", "text"],
              "properties": {
                "heading_key": {
                  "type": ["string", "null"],
                  "enum": [null, "mechanism", "scheduling", "cache", "code_relation", "engineering", "result", "boundary", "contradiction", "implication"]
                },
                "text": {"type": "string", "minLength": 20, "maxLength": 360}
              },
              "additionalProperties": false
            }
          },
          "used_fields": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["title", "core_conclusion", "mechanism", "result", "boundary", "project_relevance"]
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
