{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public intelligence knowledge index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_scope", "roadmaps", "ideas", "frontier_clusters"],
  "properties": {
    "schema_version": {"const": 1},
    "evidence_scope": {"const": "published_archive_only"},
    "roadmaps": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["topic_id", "topic_name", "path", "version", "change_type", "updated_by_issue", "summary"],
        "properties": {
          "topic_id": {"type": "string", "minLength": 1},
          "topic_name": {"type": "string", "minLength": 1},
          "path": {"type": "string", "pattern": "^knowledge/roadmaps/.+\\.json$"},
          "version": {"type": "integer", "minimum": 1},
          "change_type": {"enum": ["material_change", "no_material_change"]},
          "updated_by_issue": {"type": "string", "format": "date"},
          "summary": {"type": "string", "minLength": 1}
        }
      }
    },
    "ideas": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["idea_id", "title", "idea_type", "status", "topic_ids", "path", "last_updated_issue"],
        "properties": {
          "idea_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "idea_type": {"enum": ["research_hypothesis", "solution_concept"]},
          "status": {"enum": ["seed", "observing", "ready_for_validation", "promising", "rejected", "proposal_candidate"]},
          "topic_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "path": {"type": "string", "pattern": "^knowledge/ideas/.+\\.json$"},
          "last_updated_issue": {"type": "string", "format": "date"}
        }
      }
    },
    "frontier_clusters": {"type": "array", "items": {"type": "object"}}
  }
}
