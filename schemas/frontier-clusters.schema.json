{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frontier exploration clusters",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_scope", "clusters"],
  "properties": {
    "schema_version": {"const": 1},
    "evidence_scope": {"const": "published_archive_only"},
    "clusters": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["cluster_id", "name", "status", "first_seen_issue", "last_seen_issue", "evidence_item_ids", "source_urls", "idea_ids", "promotion_reason"],
        "properties": {
          "cluster_id": {"type": "string", "pattern": "^frontier_[a-z0-9_]+$"},
          "name": {"type": "string", "minLength": 1},
          "status": {"enum": ["temporary", "promoted"]},
          "first_seen_issue": {"type": "string", "format": "date"},
          "last_seen_issue": {"type": "string", "format": "date"},
          "evidence_item_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "source_urls": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uri"}},
          "idea_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^idea_[a-f0-9]{20}$"}},
          "promotion_reason": {"type": ["string", "null"]}
        }
      }
    }
  }
}
