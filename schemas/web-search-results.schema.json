{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["results"],
  "properties": {
    "results": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["title", "url", "publisher", "published_at", "source_level", "summary", "primary"],
        "properties": {
          "title": {"type": "string"},
          "url": {"type": "string"},
          "publisher": {"type": "string"},
          "published_at": {"type": ["string", "null"]},
          "source_level": {"type": "string", "enum": ["A", "B", "C"]},
          "summary": {"type": "string"},
          "primary": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
