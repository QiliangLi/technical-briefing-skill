{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["results"],
  "properties": {
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": ["candidate_id", "relevant", "score", "reason", "fulltext_required"],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "relevant": {"type": "boolean"},
          "score": {"type": "number", "minimum": 0, "maximum": 100},
          "reason": {"type": "string", "minLength": 1},
          "fulltext_required": {"type": "boolean"},
          "topic_fit": {"enum": ["direct", "adjacent", "tangential", "off_topic"]},
          "core_contribution": {"type": "string", "minLength": 1, "maxLength": 80},
          "matched_direction_id": {"type": "string", "minLength": 1, "maxLength": 120},
          "boundary_conflict": {"type": "boolean"},
          "technology_value": {
            "type": "object",
            "required": ["novelty", "architecture_impact", "industry_signal", "project_alignment"],
            "properties": {
              "novelty": {"$ref": "#/$defs/value_dimension"},
              "architecture_impact": {"$ref": "#/$defs/value_dimension"},
              "industry_signal": {"$ref": "#/$defs/value_dimension"},
              "project_alignment": {"$ref": "#/$defs/value_dimension"}
            },
            "additionalProperties": false
          },
          "matched_signals": {
            "type": "array",
            "items": {"type": "string"},
            "maxItems": 8
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "value_dimension": {
      "type": "object",
      "required": ["score", "reason"],
      "properties": {
        "score": {"type": "number", "minimum": 0, "maximum": 5},
        "reason": {"type": "string", "minLength": 1, "maxLength": 240}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
