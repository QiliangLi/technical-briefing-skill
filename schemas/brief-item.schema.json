{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["title", "type", "topic_name", "published_at", "core_conclusion", "mechanism", "result", "boundary", "project_relevance", "keywords", "sources", "score"],
  "properties": {
    "title": {"type": "string", "minLength": 4, "maxLength": 80},
    "type": {"type": "string"},
    "topic_name": {"type": "string"},
    "direction_name": {"type": "string"},
    "published_at": {"type": "string"},
    "importance": {"type": "string", "enum": ["重点关注", "值得关注", "一般"]},
    "core_conclusion": {"type": "string"},
    "mechanism": {"type": "string"},
    "result": {"type": "string"},
    "boundary": {"type": "string"},
    "project_relevance": {"type": "string"},
    "keywords": {"type": "array", "minItems": 3, "maxItems": 5, "items": {"type": "string"}},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["publisher", "url", "source_level", "primary"],
        "properties": {
          "publisher": {"type": "string"},
          "url": {"type": "string"},
          "source_level": {"type": "string", "enum": ["A", "B", "C"]},
          "primary": {"type": "boolean"},
          "published_at": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "discovered_via": {"type": ["string", "null"]},
    "incremental_update": {"type": "boolean"},
    "incremental_change": {"type": ["string", "null"]},
    "score": {"type": "number", "minimum": 0, "maximum": 100}
  },
  "additionalProperties": false
}
