{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["results"],
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "brief_item_id",
          "title",
          "core_conclusion",
          "mechanism",
          "result",
          "boundary",
          "project_relevance"
        ],
        "properties": {
          "brief_item_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 4, "maxLength": 48},
          "core_conclusion": {"type": "string", "minLength": 25, "maxLength": 95},
          "mechanism": {"type": "string", "minLength": 18, "maxLength": 75},
          "result": {"type": "string", "minLength": 18, "maxLength": 80},
          "boundary": {"type": "string", "minLength": 10, "maxLength": 55},
          "project_relevance": {"type": "string", "minLength": 18, "maxLength": 65}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
