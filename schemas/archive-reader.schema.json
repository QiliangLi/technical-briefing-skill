{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "reader_contract_version",
    "source_issue_hash",
    "issue_date",
    "headline",
    "judgements",
    "watch_next",
    "items",
    "radar",
    "generated_at",
    "rewrite_status"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "reader_contract_version": {"const": 1},
    "source_issue_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "issue_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "headline": {"type": "string", "minLength": 1, "maxLength": 180},
    "judgements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "body", "evidence_item_ids"],
        "properties": {
          "title": {"type": "string", "maxLength": 120},
          "body": {"type": "string", "minLength": 1, "maxLength": 1000},
          "evidence_item_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    },
    "watch_next": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "items": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["source_item_hash", "role", "topic_id", "direction_id", "published_at", "score", "sources", "title", "lead", "body", "takeaway"],
        "properties": {
          "source_item_hash": {"type": "string", "minLength": 16},
          "role": {"enum": ["core", "supplement"]},
          "topic_id": {"type": ["string", "null"]},
          "direction_id": {"type": ["string", "null"]},
          "published_at": {"type": ["string", "null"]},
          "score": {"type": ["number", "null"]},
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["publisher", "url", "source_level"],
              "properties": {
                "publisher": {"type": "string"},
                "url": {"type": "string", "minLength": 1},
                "source_level": {"type": ["string", "null"]},
                "primary": {"type": "boolean"},
                "published_at": {"type": ["string", "null"]}
              },
              "additionalProperties": false
            }
          },
          "title": {"type": "string", "minLength": 1, "maxLength": 120},
          "lead": {"type": "string", "minLength": 1, "maxLength": 500},
          "body": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
          "takeaway": {"type": ["string", "null"], "maxLength": 500}
        },
        "additionalProperties": false
      }
    },
    "radar": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["radar_id", "source_signal_hash", "category", "signal", "summary", "source_urls"],
        "properties": {
          "radar_id": {"type": "string", "minLength": 8},
          "source_signal_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "category": {"type": "string", "minLength": 1},
          "signal": {"type": "string", "minLength": 1, "maxLength": 240},
          "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
          "source_urls": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "generated_at": {"type": "string", "minLength": 1},
    "rewrite_status": {"enum": ["current_run_reader_projection", "historical_semantic_rewrite"]}
  },
  "additionalProperties": false
}
