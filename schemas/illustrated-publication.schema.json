{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["status", "illustrations", "notes"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["complete", "partial", "fallback_to_text"]
    },
    "illustrations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "concept_name",
          "status",
          "placement",
          "topic_id",
          "generated_asset_path",
          "published_asset_url",
          "alt",
          "caption",
          "persona_used",
          "qa_notes"
        ],
        "properties": {
          "concept_name": {"type": "string", "minLength": 1},
          "status": {
            "type": "string",
            "enum": ["generated", "fallback_to_text", "failed"]
          },
          "placement": {
            "type": "string",
            "enum": ["after_judgements", "before_topic"]
          },
          "topic_id": {"type": ["string", "null"]},
          "generated_asset_path": {"type": ["string", "null"]},
          "published_asset_url": {"type": ["string", "null"]},
          "alt": {"type": "string"},
          "caption": {"type": "string"},
          "persona_used": {"type": "boolean"},
          "qa_notes": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {"status": {"const": "generated"}},
              "required": ["status"]
            },
            "then": {
              "properties": {
                "persona_used": {"const": true},
                "generated_asset_path": {"type": "string", "minLength": 1},
                "published_asset_url": {
                  "type": "string",
                  "anyOf": [
                    {"pattern": "^https://raw\\.githubusercontent\\.com/[^/]+/[^/]+/[0-9a-fA-F]{40}/.+"},
                    {
                      "pattern": "^https://github\\.com/[^/]+/[^/]+/releases/download/[^/]+/[^/?#]+\\.(?i:png|jpe?g|gif|webp|svg)$"
                    }
                  ]
                }
              }
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}
