{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["headline", "judgements", "topic_names", "watch_next"],
  "properties": {
    "headline": {"type": "string", "minLength": 1},
    "judgements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["title", "body", "evidence_item_ids"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "body": {"type": "string", "minLength": 2},
          "evidence_item_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    },
    "topic_names": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "watch_next": {"type": "array", "maxItems": 3, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
