{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["judgements", "topic_names", "watch_next"],
  "properties": {
    "headline": {"type": "string", "minLength": 1, "maxLength": 80},
    "judgements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["title", "body", "evidence_item_ids"],
        "properties": {
          "title": {"type": "string", "minLength": 4, "maxLength": 64},
          "body": {"type": "string", "minLength": 20, "maxLength": 400},
          "evidence_item_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    },
    "topic_names": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "watch_next": {"type": "array", "maxItems": 3, "items": {"type": "string", "maxLength": 100}},
    "project_insights": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "topic_id",
          "topic_name",
          "project_question",
          "effect",
          "confidence",
          "insight",
          "next_action",
          "evidence_item_ids"
        ],
        "properties": {
          "topic_id": {"type": "string", "minLength": 1},
          "topic_name": {"type": "string", "minLength": 1},
          "project_question": {"type": "string", "minLength": 1},
          "effect": {"enum": ["supports", "challenges", "narrows", "opens"]},
          "confidence": {"enum": ["high", "medium", "low"]},
          "insight": {"type": "string", "minLength": 12, "maxLength": 240},
          "next_action": {"type": "string", "minLength": 8, "maxLength": 200},
          "evidence_item_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    },
    "radar_signals": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["category", "signal", "summary", "source_urls"],
        "properties": {
          "category": {"type": "string", "minLength": 1, "maxLength": 40},
          "signal": {"type": "string", "minLength": 8, "maxLength": 160},
          "summary": {"type": "string", "minLength": 20, "maxLength": 260},
          "source_urls": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 8}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
