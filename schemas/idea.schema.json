{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence-bound research hypothesis or solution concept",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "idea_id", "identity", "idea_type", "title", "problem", "hypothesis",
    "mechanism", "expected_effect", "topic_ids", "status", "evidence_for", "evidence_against",
    "unknowns", "validation_plan", "first_seen_issue", "last_updated_issue", "decision_log"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "idea_id": {"type": "string", "pattern": "^idea_[a-f0-9]{20}$"},
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["problem_key", "mechanism_key", "target_key"],
      "properties": {
        "problem_key": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
        "mechanism_key": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
        "target_key": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"}
      }
    },
    "idea_type": {"enum": ["research_hypothesis", "solution_concept"]},
    "title": {"type": "string", "minLength": 1},
    "problem": {"type": "string", "minLength": 1},
    "hypothesis": {"type": "string", "minLength": 1},
    "mechanism": {"type": "string", "minLength": 1},
    "expected_effect": {"type": "string", "minLength": 1},
    "topic_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "status": {"enum": ["seed", "observing", "ready_for_validation", "promising", "rejected", "proposal_candidate"]},
    "evidence_for": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
    "evidence_against": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "unknowns": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "validation_plan": {"$ref": "#/$defs/validation_plan"},
    "first_seen_issue": {"type": "string", "format": "date"},
    "last_updated_issue": {"type": "string", "format": "date"},
    "decision_log": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/decision"}}
  },
  "$defs": {
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["item_id", "issue_date", "source_urls", "reason"],
      "properties": {
        "item_id": {"type": "string", "minLength": 1},
        "issue_date": {"type": "string", "format": "date"},
        "source_urls": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uri"}},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "validation_plan": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "minimal_model", "inputs", "baselines", "metrics", "support_criteria", "reject_criteria", "limitations", "execution_status"],
      "properties": {
        "mode": {"enum": ["simulation", "data_analysis", "benchmark", "prototype", "continued_observation"]},
        "minimal_model": {"type": "string", "minLength": 1},
        "inputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "baselines": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "metrics": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "support_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "reject_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "execution_status": {"const": "suggestion_only"}
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "issue_date", "decision", "from_status", "to_status", "reason", "evidence_item_ids"],
      "properties": {
        "event_id": {"type": "string", "minLength": 1},
        "issue_date": {"type": "string", "format": "date"},
        "decision": {"enum": ["created", "evidence_added", "status_changed", "rejected", "reopened", "merge_suggested", "wording_updated"]},
        "from_status": {"type": ["string", "null"]},
        "to_status": {"enum": ["seed", "observing", "ready_for_validation", "promising", "rejected", "proposal_candidate"]},
        "reason": {"type": "string", "minLength": 1},
        "evidence_item_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
