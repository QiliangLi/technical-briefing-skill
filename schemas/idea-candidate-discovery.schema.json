{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded Idea candidate discovery result",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidates", "no_ops", "covered_trigger_item_ids"],
  "properties": {
    "candidates": {"type": "array", "items": {"type": "object"}},
    "no_ops": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["item_id", "reason_code", "reason"],
        "properties": {
          "item_id": {"type": "string", "minLength": 1},
          "reason_code": {"enum": ["no_problem", "no_mechanism", "no_target", "no_testable_effect", "duplicate_signal", "measurement_only", "ineligible_evidence", "no_new_semantics"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "covered_trigger_item_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
