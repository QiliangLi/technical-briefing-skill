{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Published-evidence technology roadmap",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "roadmap_id", "topic_id", "topic_name", "version",
    "evidence_scope", "updated_by_issue", "change_type", "summary", "view_mode",
    "branches", "history", "change_log"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "roadmap_id": {"type": "string", "pattern": "^roadmap_[a-z0-9_]+$"},
    "topic_id": {"type": "string", "minLength": 1},
    "topic_name": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "evidence_scope": {"const": "published_archive_only"},
    "updated_by_issue": {"type": "string", "format": "date"},
    "change_type": {"enum": ["material_change", "no_material_change"]},
    "summary": {"type": "string", "minLength": 1},
    "view_mode": {"enum": ["roadmap", "evidence_timeline"]},
    "branches": {
      "type": "array",
      "items": {"$ref": "#/$defs/branch"}
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "issue_date", "change_type", "path"],
        "properties": {
          "version": {"type": "integer", "minimum": 1},
          "issue_date": {"type": "string", "format": "date"},
          "change_type": {"enum": ["material_change", "no_material_change"]},
          "path": {"type": "string", "pattern": "^knowledge/history/roadmaps/.+\\.json$"}
        }
      }
    },
    "change_log": {
      "type": "array",
      "items": {"$ref": "#/$defs/change"}
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "issue_date", "source_urls", "reason"],
      "properties": {
        "item_id": {"type": "string", "minLength": 1},
        "issue_date": {"type": "string", "format": "date"},
        "source_urls": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "format": "uri"}
        },
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_id", "name", "problem", "mechanisms", "status", "first_seen_issue",
        "evidence_for", "evidence_against", "transition_reason"
      ],
      "properties": {
        "stage_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "name": {"type": "string", "minLength": 1},
        "problem": {"type": "string", "minLength": 1},
        "mechanisms": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "status": {"enum": ["supported", "emerging", "contested", "inferred"]},
        "first_seen_issue": {"type": "string", "format": "date"},
        "evidence_for": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "evidence_against": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "transition_reason": {"type": ["string", "null"]}
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch_id", "name", "direction_ids", "status", "stages", "evidence_timeline",
        "open_questions", "evidence_item_ids", "source_urls"
      ],
      "properties": {
        "branch_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "name": {"type": "string", "minLength": 1},
        "direction_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "status": {"enum": ["supported", "emerging", "contested", "inferred"]},
        "stages": {"type": "array", "items": {"$ref": "#/$defs/stage"}},
        "evidence_timeline": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "open_questions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidence_item_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "source_urls": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "uri"}}
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "issue_date", "change_type", "version", "summary", "evidence_item_ids"],
      "properties": {
        "event_id": {"type": "string", "minLength": 1},
        "issue_date": {"type": "string", "format": "date"},
        "change_type": {"enum": ["material_change", "no_material_change"]},
        "version": {"type": "integer", "minimum": 1},
        "summary": {"type": "string", "minLength": 1},
        "evidence_item_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
