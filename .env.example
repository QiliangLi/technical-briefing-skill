# Optional GitHub token increases API limits.
GITHUB_TOKEN=

# Agently Mail is the default send backend. It uses the locally authenticated
# agently-cli account; no SMTP password is needed.
EMAIL_BACKEND=agently
AGENTLY_CLI=agently-cli
# Comma-separated recipients; AGENTLY_TO takes precedence over EMAIL_TO.
AGENTLY_TO=
AGENTLY_CC=
AGENTLY_BCC=
AGENTLY_TIMEOUT_SECONDS=60

# SMTP is an explicit fallback: set EMAIL_BACKEND=smtp to use it.
SMTP_HOST=
# SMTP_PORT defaults to 465 for ssl, 587 for starttls/tls, and 25 for none.
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
# Preferred: ssl, starttls, tls, or explicit none. This takes precedence over SMTP_USE_SSL.
SMTP_SECURITY=ssl
# Legacy alternative (leave commented when SMTP_SECURITY is used): SMTP_USE_SSL=true
EMAIL_FROM=
# SMTP_FROM is a compatibility alias for EMAIL_FROM.
SMTP_FROM=
EMAIL_TO=
# SMTP_TO is a compatibility alias for EMAIL_TO; one recipient field is required.
SMTP_TO=

# Optional sender display name.
EMAIL_SENDER_NAME=技术情报简报
